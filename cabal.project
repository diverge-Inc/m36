packages:
  .

package *
  split-sections: True

-- Upper bounds of third-party packages that have not caught up with newer
-- GHC/boot library versions. Keep this in sync with nix/dependencies.nix, which
-- loosens exactly the same bounds for the Nix build (instead of jailbreaking).
-- Remove an entry once the package publishes a release or revision with higher bounds.

-- barbies-th-0.1.11: base < 4.20, template-haskell < 2.22.
-- Note: since template-haskell 2.21 (GHC 9.8) barbies-th also needs a one-line
-- source fix (nix/patches/barbies-th-template-haskell-2.21.patch), which the Nix
-- build applies; a plain Hackage build with GHC >= 9.8 does not have it.
if impl(ghc >= 9.10)
  allow-newer:
    barbies-th:base,
    barbies-th:template-haskell
